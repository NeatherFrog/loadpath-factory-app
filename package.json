{
  "name": "retrodrop-dashboard",
  "productName": "RetroDrop Dashboard",
  "version": "0.1.2",
  "description": "Airdrop research dashboard and delta-neutral points farming bot for perp DEXes",
  "author": "NeatherFrog",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "release": "npm run build && electron-builder --publish always"
  },
  "devDependencies": {
    "@lifi/perps-sdk-provider-lighter": "^37.0.1",
    "@nadohq/client": "^0.53.0",
    "@nktkas/hyperliquid": "^0.33.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "bignumber.js": "^11.1.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "viem": "^2.52.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NeatherFrog/loadpath-factory-app.git"
  },
  "build": {
    "appId": "com.neatherfrog.retrodrop",
    "productName": "RetroDrop Dashboard",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      },
      {
        "from": "dist/wasm",
        "to": "wasm"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "NeatherFrog",
        "repo": "loadpath-factory-app",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RetroDrop-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "shortcutName": "RetroDrop Dashboard"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Finance",
      "icon": "build/icon.png"
    }
  }
}
